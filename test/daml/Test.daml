module Test where

import Daml.Script

import Common.Types
import Governance.Approval
import Products.DepositProduct
import Deposits.DepositAgreement
import Deposits.DepositPosition
import Issuance.IssuanceRequest
import Transfers.TransferRequest
import Redemption.RedemptionRequest
import Settlement.SettlementEvidence

data World = World with
  issuer : Party
  governor : Party
  alice : Party
  bob : Party
  checker : Party

setupWorld : Script World
setupWorld = do
  issuer <- allocateParty "Issuer"
  governor <- allocateParty "Governor"
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  checker <- allocateParty "Checker"
  pure World with issuer, governor, alice, bob, checker

createActiveProduct : World -> Script (ContractId DepositProduct)
createActiveProduct w = submitMulti [w.issuer, w.governor] [] do
  createCmd DepositProduct with
    issuer = w.issuer
    productGovernor = w.governor
    productId = "DEMAND-1"
    productVersion = "v1"
    currency = "INR"
    minimumPrincipal = 1000.0
    maximumPrincipal = 1000000.0
    transferable = True
    earlyRedemptionAllowed = True
    termsDigest = "terms-1"
    status = ProductActive

createAgreement : World -> ContractId DepositProduct -> Script (ContractId DepositAgreement)
createAgreement w productId = submitMulti [w.issuer, w.alice] [] do
  createCmd DepositAgreement with
    issuer = w.issuer
    depositor = w.alice
    agreementRef = "AGR-1"
    coreAccountRefDigest = "digest-1"
    productId = productId
    productVersion = "v1"
    currency = "INR"
    principal = 5000.0
    status = DepositPending

-- Issue a position using a checker-signed approval and a permanent operation
-- reservation, mirroring the documented maker/checker flow.
issuePosition : World -> ContractId DepositProduct -> ContractId DepositAgreement -> Text -> Decimal -> Script (ContractId DepositPosition)
issuePosition w productId agreementId opId amount = do
  registryId <- submit w.issuer do
    createCmd OperationRegistry with
      issuer = w.issuer
      operationId = opId
      operationKind = "ISSUANCE"
      payloadDigest = opId
  approvalId <- submit w.checker do
    createCmd ApprovalEvidence with
      issuer = w.issuer
      maker = w.issuer
      checker = w.checker
      operationId = opId
      action = "ISSUANCE"
      subjectRef = "POS-" <> opId
      productVersion = "v1"
      transactionAmount = Some amount
      currency = Some "INR"
      beneficiary = Some w.alice
      payloadDigest = opId
  requestId <- submitMulti [w.issuer, w.alice] [] do
    createCmd IssuanceRequest with
      issuer = w.issuer
      requester = w.alice
      holder = w.alice
      operationId = opId
      agreementId = agreementId
      productId = productId
      positionRef = "POS-" <> opId
      currency = "INR"
      amount = amount
      status = IssuancePending
  submitMulti [w.issuer, w.alice, w.checker] [] do
    exerciseCmd requestId Execute with
      registryId = registryId
      payloadDigest = opId
      checker = w.checker
      approvalId = approvalId

testIssuanceCreatesPosition : Script ()
testIssuanceCreatesPosition = do
  w <- setupWorld
  productId <- createActiveProduct w
  agreementId <- createAgreement w productId
  positionId <- issuePosition w productId agreementId "OP-1" 5000.0
  position <- queryContractId w.issuer positionId
  case position of
    None -> abort "Position was not created"
    Some p -> do
      assertMsg "Unexpected amount" (p.amount == 5000.0)
      assertMsg "Unexpected holder" (p.holder == w.alice)
      assertMsg "Unexpected status" (p.status == PositionActive)

testTransferOfferAccept : Script ()
testTransferOfferAccept = do
  w <- setupWorld
  productId <- createActiveProduct w
  agreementId <- createAgreement w productId
  positionId <- issuePosition w productId agreementId "OP-1" 5000.0
  offerId <- submitMulti [w.issuer, w.alice] [] do
    exerciseCmd positionId OfferTransfer with
      newHolder = w.bob
      operationId = "OP-T1"
  submit w.bob do
    exerciseCmd offerId Accept
  positions <- query @DepositPosition w.issuer
  assertMsg "Expected exactly one position after transfer" (length positions == 1)
  let holders = map (\(_, p) -> p.holder) positions
  assertMsg "Bob should hold the position" (holders == [w.bob])

testUnauthorizedAcceptFails : Script ()
testUnauthorizedAcceptFails = do
  w <- setupWorld
  productId <- createActiveProduct w
  agreementId <- createAgreement w productId
  positionId <- issuePosition w productId agreementId "OP-1" 5000.0
  offerId <- submitMulti [w.issuer, w.alice] [] do
    exerciseCmd positionId OfferTransfer with
      newHolder = w.bob
      operationId = "OP-T1"
  submitMustFail w.alice do
    exerciseCmd offerId Accept

testPartialRedemption : Script ()
testPartialRedemption = do
  w <- setupWorld
  productId <- createActiveProduct w
  agreementId <- createAgreement w productId
  positionId <- issuePosition w productId agreementId "OP-1" 5000.0
  registryId <- submit w.issuer do
    createCmd OperationRegistry with
      issuer = w.issuer
      operationId = "OP-R1"
      operationKind = "REDEMPTION"
      payloadDigest = "OP-R1"
  approvalId <- submit w.checker do
    createCmd ApprovalEvidence with
      issuer = w.issuer
      maker = w.issuer
      checker = w.checker
      operationId = "OP-R1"
      action = "REDEMPTION"
      subjectRef = "POS-OP-1"
      productVersion = "v1"
      transactionAmount = Some 2000.0
      currency = Some "INR"
      beneficiary = Some w.alice
      payloadDigest = "OP-R1"
  requestId <- submitMulti [w.issuer, w.alice] [] do
    createCmd RedemptionRequest with
      issuer = w.issuer
      holder = w.alice
      operationId = "OP-R1"
      positionId = positionId
      amount = 2000.0
      currency = "INR"
      status = RedemptionPending
  submitMulti [w.issuer, w.alice, w.checker] [] do
    exerciseCmd requestId Execute with
      registryId = registryId
      payloadDigest = "OP-R1"
      checker = w.checker
      approvalId = approvalId
  positions <- query @DepositPosition w.issuer
  assertMsg "Expected exactly one residual position" (length positions == 1)
  let amounts = map (\(_, p) -> p.amount) positions
  assertMsg "Residual amount should be 3000" (amounts == [3000.0])

testSettlementEvidenceUpdate : Script ()
testSettlementEvidenceUpdate = do
  w <- setupWorld
  evidenceId <- submit w.issuer do
    createCmd SettlementEvidence with
      issuer = w.issuer
      operationId = "OP-S1"
      settlementRef = "SET-1"
      evidenceDigest = "ev-1"
      status = SettlementPending
  submit w.issuer do
    exerciseCmd evidenceId RecordUpdate with
      newStatus = SettlementConfirmed
      newEvidenceDigest = "ev-2"
  evidences <- query @SettlementEvidence w.issuer
  assertMsg "Expected exactly one settlement evidence record" (length evidences == 1)
  let statuses = map (\(_, e) -> e.status) evidences
  assertMsg "Settlement should be confirmed" (statuses == [SettlementConfirmed])
